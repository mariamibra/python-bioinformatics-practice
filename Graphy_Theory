>>> def parse_fasta(fasta_input):
	sequences = {}
	current_label = None
	for line in fasta_input.strip().splitlines(): #split() splitlines() removes the newline charater (whitespaces) from the begining and the end of the line
		line = line.strip()
		if not line:
			continue
		if line.startswith(">"): #if the line starts with ">"
			current_label = line[1:] #stores everything from index 1 all the way to the end
			sequences[current_label] = [] #sequences is a dictionary, while cuurent_label is the key
		else:
			sequences[current_label].append(line) #the DNA string is the value
	return {
		label: "".join(seq_list) for label, seq_list in sequences.items()
              }

